# Datos de la base de datos COMPARTIDA (Aiven).
#
# Copia este archivo:   cp .env.aiven.example .env.aiven
# y pide los datos reales al equipo.
#
# Solo se usa cuando arrancas en modo compartido:
#   docker compose --env-file .env.aiven -f docker-compose.yml -f docker-compose.aiven.yml up
#
# Para el modo local (lo normal) NO necesitas este archivo ni ningun otro.

DB_HOST=xxxxx.a.aivencloud.com
DB_PORT=00000
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=pidele-la-password-al-equipo
DB_SSL_MODE=REQUIRED

CORS_ORIGINS=http://localhost:5173
