# Copia este archivo a `.env` y ajusta lo que necesites:  cp .env.example .env
# `.env` está en .gitignore: NUNCA lo subas, lleva contraseñas reales.
#
# Si solo quieres correr el proyecto en tu máquina, NO necesitas hacer nada:
# `docker compose up` funciona con los valores por defecto.

# ─── Base de datos ────────────────────────────────────────────────────────────
# Por defecto: el MySQL que levanta docker compose. No toques nada.
DB_HOST=db
DB_PORT=3306
DB_NAME=farmasol_db
DB_USER=root
DB_PASSWORD=admin123
DB_SSL_MODE=DISABLED

# Puerto en TU máquina para conectar con MySQL Workbench (el 3306 suele estar
# ocupado por un MySQL instalado localmente, por eso usamos 3307).
DB_PORT_HOST=3307

# ─── BD compartida en Aiven ───────────────────────────────────────────────────
# Para trabajar contra la BD del equipo, comenta las 6 líneas de arriba y
# descomenta estas, con los datos del Service URI de Aiven:
#   mysql://avnadmin:CONTRASEÑA@HOST:PUERTO/defaultdb?ssl-mode=REQUIRED
#
# DB_HOST=farmasol-xxxxx.a.aivencloud.com
# DB_PORT=12345
# DB_NAME=defaultdb
# DB_USER=avnadmin
# DB_PASSWORD=la-contraseña-que-te-da-aiven
# DB_SSL_MODE=REQUIRED
#
# Con Aiven ya no hace falta el contenedor de BD:
#   docker compose up back front

# ─── Seguridad ────────────────────────────────────────────────────────────────
# Clave para firmar los JWT. La de por defecto sirve para desarrollo.
# Para generar una nueva:  openssl rand -base64 64
FARMASOL_JWT_SECRET=ZmFybWFzb2wtZGV2LXNlY3JldC1jYW1iaWFyLWVuLXByb2R1Y2Npb24tMjAyNi1jbGF2ZS1sYXJnYQ==

# Orígenes que pueden llamar a la API (separados por coma).
CORS_ORIGINS=http://localhost:5173
