# Configuración para correr el backend SIN Docker.
#
# 1. Copia este archivo en esta misma carpeta con el nombre .env
#      (apps/back/.env)
# 2. Pon la contraseña de TU MySQL en DB_PASSWORD.
#
# .env no se sube al repo: está en .gitignore, así que tu contraseña se queda
# en tu computadora.

DB_PASSWORD=pon_aqui_tu_contraseña_de_mysql

# Solo si tu MySQL no usa los valores de siempre, quita el # y ajusta:
# DB_USER=root
# DB_PORT=3306
# DB_NAME=farmasol_db
